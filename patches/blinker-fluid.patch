+  if (!url.is_valid()) {
+    return;
+  }
+  std::u16string t = _shell->web_contents()->GetTitle();
+  NSString* title =
+      t.empty() ? base::SysUTF8ToNSString(url.spec()) : base::SysUTF16ToNSString(t);
+  NSMutableArray* bms = [self bookmarks];
+  [bms addObject:@{
+    @"title" : title,
+    @"url" : base::SysUTF8ToNSString(url.spec())
