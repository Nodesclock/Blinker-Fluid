+int LoadStartsInLast10s() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  int count = 0;
+  for (const base::TimeTicks& t : g_recent_load_starts) {
+    if (!t.is_null() && now - t <= base::Seconds(10)) {
+      ++count;
+    }
+  }
+  return count;
+}
