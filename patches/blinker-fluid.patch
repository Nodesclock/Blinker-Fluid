+           basic_kr == KERN_SUCCESS
+               ? static_cast<unsigned long long>(basic_info.resident_size)
+               : 0,
+           vm_kr == KERN_SUCCESS
+               ? static_cast<unsigned long long>(vm_info.phys_footprint)
+               : 0,
+           basic_kr == KERN_SUCCESS
+               ? static_cast<unsigned long long>(basic_info.virtual_size)
+               : 0,
+           basic_kr, vm_kr);
