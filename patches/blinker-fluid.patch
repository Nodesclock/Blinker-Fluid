+- (void)closeCurrentTab {
+  if (content::Shell::windows().size() <= 1) {
+    return;
+  }
+  content::Shell* current = _shell;
+  for (content::Shell* s : content::Shell::windows()) {
+    if (s != current) {
+      [self showTabWindow:s];
+      break;
+    }
+  }
+  current->Close();
+  BlinkSaveOpenTabs();
+}
