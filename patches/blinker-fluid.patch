+          CFSTR("BlinkRecentHeartbeats"), kCFPreferencesCurrentApplication)) {
+    if (CFGetTypeID(stored) == CFArrayGetTypeID()) {
+      CFArrayRef arr = static_cast<CFArrayRef>(stored);
+      CFIndex n = CFArrayGetCount(arr);
