# actool хоче simulator runtime навіть для device каталогу, а на VM його нема.
# Це той самий каталог, зібраний коли runtime ще був.
bundle_data("prebuilt_catalog") {
  sources = [ "prebuilt/Assets.car" ]
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
}

# Іконка на головному екрані та лого стартової сторінки. Info.plist посилається
# на них за ім'ям, тож без цього кожна збірка виходила без іконки.
bundle_data("app_icons") {
  sources = [
    "icons/AppIcon60x60@2x.png",
    "icons/AppIcon60x60@3x.png",
    "icons/AppIcon76x76@2x.png",
    "icons/blinker_logo.png",
    "icons/blinker_logo@2x.png",
    "icons/blinker_logo@3x.png",
  ]
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
}

# Переклади інтерфейсу, читає BlinkL.
bundle_data("ui_strings") {
  sources = [ "ui_strings.json" ]
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
}

