target_os = "ios"
target_cpu = "arm64"
target_environment = "device"
use_blink = true
is_debug = false
is_component_build = false
ios_enable_code_signing = false
symbol_level = 0
mac_sdk_min = "14.5"
ios_deployment_target = "14.0"
ios_content_shell_bundle_identifier = "com.nodesclock.blinkerfluid"
treat_warnings_as_errors = false

# Без резерву під пісочницю V8, стиснення вказівників лишається.
v8_enable_sandbox = false
v8_enable_pointer_compression = true
v8_enable_drumbrake = false

# Без великого резерву під caged heap у cppgc.
cppgc_enable_caged_heap = false

proprietary_codecs = true
ffmpeg_branding = "Chrome"
dcheck_always_on = false

# Справжня версія Chromium замість 999.77.34.5 з content_shell. Вона йде в
# User Agent і Sec-CH-UA, а з версією 999 Google вважав браузер підробкою, на
# вході показував "this browser may not be secure" і сипав капчі.
content_shell_version = "159.0.8154.13"
content_shell_major_version = "159"
blinker_enable_diagnostics = false
