target_os = "ios"
target_cpu = "arm64"
target_environment = "device"
use_blink = true
is_debug = false
is_component_build = false
ios_enable_code_signing = false
symbol_level = 0
# iOS-15 port / iOS-14 support: build min iOS 14.0. At <14.5 the SDK's
# $ld$previous redirect routes the AVAudioSession* symbols to AVFoundation
# (present on every iOS) instead of the standalone AVFAudio.framework (which only
# exists top-level on 14.5+), so the app launches AND audio works on iOS 14. A
# lower target never breaks 15/16 (it only adds back-compat) and auto-weakens any
# other post-14.0 system framework, pre-empting the next missing-symbol crash.
ios_deployment_target = "14.0"
treat_warnings_as_errors = false

# iOS-15 port: V8 normally reserves a ~1TB virtual "sandbox" cage at Isolate
# init; iOS cannot grant that even with extended-virtual-addressing, so the
# renderer died with "Failed to reserve the virtual address space for the V8
# sandbox". Disabling the sandbox drops the reservation to the 4GB
# pointer-compression cage (fits under EVA). Keeps JIT + pointer compression.
v8_enable_sandbox = false

# DrumBrake requires pointer compression and the shared pointer cage.
v8_enable_pointer_compression = true
v8_enable_drumbrake = true

# iOS-15 port: cppgc (Oilpan, Blink's GC) reserves its own "caged heap" — it
# tries to reserve 2 x 4GB = 8GB of virtual address space at renderer init and
# aborts (no fallback) when it can't, on this 4GB-VA device. Disable the cage so
# Oilpan uses normal page allocation (no giant reservation). Supported config.
cppgc_enable_caged_heap = false
# iOS-15 port: enable proprietary codecs (H.264/AAC) so mainstream video/audio
# (YouTube, MP4) can decode. On iOS this routes H.264 to the VideoToolbox
# hardware decoder (fast, important since JS is jitless). ffmpeg_branding=Chrome
# pulls in the proprietary-codec ffmpeg config.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# iOS-15 port: DCHECKs were aborting on debug-only invariant checks (scroll
# input handler, single-process context checks, etc.) — crashing the browser on
# normal use. Turn them off for a real release build (standard for shipping).
dcheck_always_on = false
